# Telegram Bot Token (Get it for free from @BotFather in Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Solana Treasury Wallet (Your personal Phantom/Solflare address to receive VIP payments)
TREASURY_WALLET_ADDRESS=your_solana_wallet_address_here

# Google Gemini API Key (Get a free API key from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Solana RPC Endpoint (Free from Helius or public mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# VIP Subscription Price in SOL (e.g. 0.1 SOL for 30 days)
VIP_PRICE_SOL=0.1

# Free Scans Per Day Limit
FREE_SCANS_LIMIT=5

# Admin Telegram IDs (Comma separated for /admin privileges)
ADMIN_TELEGRAM_IDS=123456789
